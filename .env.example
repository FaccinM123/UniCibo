# Copia questo file in .env e incolla i valori presi da
# Firebase Console > Panoramica progetto > Aggiungi app > Web > firebaseConfig
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Serve solo per lo script una tantum di import ricette brand (scripts/import-brand-recipes.mjs)
# Non viene mai usata a runtime dall'app in produzione.
SPOONACULAR_API_KEY=
